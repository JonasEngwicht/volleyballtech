---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { site, nav, categories } from '../data/site';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  bodyClass?: string;
}

const {
  title,
  description,
  type = 'website',
  noindex = false,
  jsonLd,
  image = '/og-default.png',
  bodyClass,
} = Astro.props;
const ogImage = new URL(image, site.url).href;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Long titles get cut off in search results, so the site name is only added when there is room.
const fullTitle = title === site.name ? site.homeTitle : title.length > 46 ? title : `${title} | ${site.name}`;
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="icon" href="/icon-v2.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#0f1f3d" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a class="logo" href="/" aria-label={`${site.name} home`}>
          <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true">
            <clipPath id="logo-clip"><circle cx="16" cy="16" r="14.5"></circle></clipPath>
            <circle cx="16" cy="16" r="14.5" fill="#5bbcf2"></circle>
            <g clip-path="url(#logo-clip)" fill="none" stroke="#fff" stroke-width="1.5"><path d="M16 16A14.5 14.5 0 0 1 28.56 23.25"></path><path d="M26.21 28.31A19.7 19.7 0 0 1 12.46 20.11"></path><path d="M18.95 31.72A24.9 24.9 0 0 1 7.85 22.58"></path><path d="M16 16A14.5 14.5 0 0 1 3.44 23.25"></path><path d="M0.24 18.69A19.7 19.7 0 0 1 14.21 10.88"></path><path d="M0.91 10.69A24.9 24.9 0 0 1 14.37 5.65"></path><path d="M16 16A14.5 14.5 0 0 1 16.00 1.50"></path><path d="M21.56 1.01A19.7 19.7 0 0 1 21.33 17.01"></path><path d="M28.14 5.59A24.9 24.9 0 0 1 25.77 19.76"></path></g>
          </svg>
          <span class="logo-text">Volleyball<span>Tech</span></span>
        </a>
        <nav class="main-nav" aria-label="Main">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <p class="logo-text">Volleyball<span>Tech</span></p>
            <p>{site.tagline}. Independent volleyball gear research, volleyball shoe comparisons and training tips for players, parents and coaches.</p>
          </div>
          <nav class="footer-col" aria-label="Volleyball gear">
            <p class="footer-title">Volleyball gear</p>
            <ul>
              {
                categories.map((c) => (
                  <li>
                    <a href={`/gear/${c.id}/`}>{c.name}</a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <nav class="footer-col" aria-label="Learn and train">
            <p class="footer-title">Learn and train</p>
            <ul>
              <li><a href="/learn/">Volleyball rules and skills</a></li>
              <li><a href="/guides/">Buying guides</a></li>
              <li><a href="/best/">Best volleyball gear</a></li>
              <li><a href="/compare/">Gear comparisons</a></li>
              <li><a href="/drills/">Volleyball drills</a></li>
            </ul>
          </nav>
          <nav class="footer-col" aria-label="About this site">
            <p class="footer-title">VolleyballTech</p>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/how-we-research/">How we research gear</a></li>
              <li><a href="/community/">Community</a></li>
              <li><a href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/legal-notice/">Legal Notice</a></li>
            </ul>
          </nav>
        </div>
        <p class="footer-disclosure">
          Some links on this site are affiliate links. If you buy through them, we may earn a commission at no
          extra cost to you. As an Amazon Associate we earn from qualifying purchases. It never decides which
          products we recommend.
          <a href="/affiliate-disclosure/">Learn more</a>.
        </p>
        <p class="footer-copy">© {year} {site.name}</p>
      </div>
    </footer>
  </body>
</html>
