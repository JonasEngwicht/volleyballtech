---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { site, sections, categories } from '../../data/site';
import { articleUrl, formatDate, getArticles } from '../../lib/content';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { section: entry.data.section, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const section = sections.find((s) => s.id === entry.data.section) ?? sections[0];
const category = entry.data.category ? categories.find((c) => c.id === entry.data.category) : undefined;
const url = new URL(articleUrl(entry), site.url).href;
const toc = headings.filter((h) => h.depth === 2);
const modified = entry.data.updated ?? entry.data.published;

const related = (await getArticles())
  .filter((a) => a.id !== entry.id && (a.data.category === entry.data.category || a.data.section === entry.data.section))
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: entry.data.title,
    description: entry.data.description,
    datePublished: entry.data.published.toISOString(),
    dateModified: modified.toISOString(),
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: section.title, item: `${site.url}/${section.id}/` },
      { '@type': 'ListItem', position: 3, name: entry.data.title, item: url },
    ],
  },
];
---

<Base title={entry.data.title} description={entry.data.description} type="article" jsonLd={jsonLd}>
  <PageHead
    title={entry.data.title}
    lead={entry.data.description}
    crumbs={[{ href: `/${section.id}/`, label: section.title }]}
  >
    <p class="meta">
      By the {site.name} team · Updated <time datetime={modified.toISOString()}>{formatDate(modified)}</time>
    </p>
  </PageHead>

  <div class="container">
    <div class="article-layout">
      <article class="prose">
        <p class="notice">
          This article may contain affiliate links. If you buy through them, we may earn a small commission at no
          extra cost to you. <a href="/affiliate-disclosure/">How we make money</a>
        </p>
        <Content />
      </article>
      <aside class="article-aside">
        {
          toc.length > 1 && (
            <nav class="toc" aria-label="Table of contents">
              <h2>In this article</h2>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
              {category && (
                <p>
                  <a href={`/gear/${category.id}/`}>Browse {category.name} →</a>
                </p>
              )}
            </nav>
          )
        }
      </aside>
    </div>
  </div>

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <h2>Keep reading</h2>
          <div class="grid">
            {related.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
