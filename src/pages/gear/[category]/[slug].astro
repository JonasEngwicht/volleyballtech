---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import AmazonButton from '../../../components/AmazonButton.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Faq from '../../../components/Faq.astro';
import { site, categories } from '../../../data/site';
import {
  getArticles,
  getProducts,
  productUrl,
  productBuyUrl,
  productHeading,
  formatDate,
  levelLabel,
  metaDescription,
} from '../../../lib/content';

export async function getStaticPaths() {
  const products = await getCollection('products', ({ data }) => !data.draft);
  return products.map((entry) => ({
    params: { category: entry.data.category, slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const p = entry.data;
const { Content, headings } = await render(entry);
const category = categories.find((c) => c.id === p.category) ?? categories[0];
const specs = Object.entries(p.specs);
const heading = productHeading(entry);
const url = new URL(productUrl(entry), site.url).href;
const hasBuyLink = productBuyUrl(entry) !== undefined;

// Alternatives: the ones named in the product file, otherwise other products in the category.
const siblings = (await getProducts(p.category)).filter((x) => x.id !== entry.id);
const named = p.alternatives.map((id) => siblings.find((x) => x.id === id)).filter((x) => x !== undefined);
const alternatives = (
  named.length > 0
    ? named
    : [
        ...siblings.filter((x) => x.data.level.some((l) => p.level.includes(l))),
        ...siblings.filter((x) => !x.data.level.some((l) => p.level.includes(l))),
      ]
).slice(0, 4);
const compared = [entry, ...alternatives];

// Guides that mention this product come first, then other guides for the category.
const articles = await getArticles();
const mentions = articles.filter((a) => (a.body ?? '').includes(productUrl(entry)));
const related = [...mentions, ...articles.filter((a) => a.data.category === p.category && !mentions.includes(a))].slice(0, 6);

const toc = [
  ...(p.verdict ? [{ slug: 'quick-take', text: 'Quick take' }] : []),
  ...(specs.length > 0 ? [{ slug: 'specs', text: 'Specs' }] : []),
  ...(p.pros.length > 0 || p.cons.length > 0 ? [{ slug: 'pros-and-cons', text: 'Pros and cons' }] : []),
  ...headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text })),
  ...(p.faq.length > 0 ? [{ slug: 'faq', text: 'Questions and answers' }] : []),
  ...(alternatives.length > 0 ? [{ slug: 'alternatives', text: 'Alternatives' }] : []),
];

const title = `${heading}: Specs, Fit, Pros & Cons`;
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: p.summary,
    mainEntityOfPage: url,
    about: { '@type': 'Thing', name: p.name },
    ...(p.updated ? { datePublished: p.updated.toISOString(), dateModified: p.updated.toISOString() } : {}),
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url, logo: { '@type': 'ImageObject', url: `${site.url}/logo-512.png` } },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
      { '@type': 'ListItem', position: 2, name: 'Gear', item: `${site.url}/gear/` },
      { '@type': 'ListItem', position: 3, name: category.name, item: `${site.url}/gear/${category.id}/` },
      { '@type': 'ListItem', position: 4, name: p.name, item: url },
    ],
  },
];
if (p.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: p.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base title={title} description={metaDescription(p.summary)} type="article" jsonLd={jsonLd} bodyClass={hasBuyLink ? 'has-buy-bar' : undefined}>
  <PageHead
    title={heading}
    lead={p.summary}
    crumbs={[
      { href: '/gear/', label: 'Gear' },
      { href: `/gear/${category.id}/`, label: category.name },
    ]}
  >
    {
      p.bestFor.length > 0 && (
        <ul class="chips" aria-label="Best for">
          {p.bestFor.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      )
    }
    <p class="meta page-meta">
      By the <a href="/about/">{site.name} team</a>
      {p.updated && (
        <>
          {' · '}Updated <time datetime={p.updated.toISOString()}>{formatDate(p.updated)}</time>
        </>
      )}
      {' · '}
      {p.testedHandsOn ? 'Tested hands-on' : 'Research-based, not yet tested hands-on'}
    </p>
    <div class="head-actions">
      <AmazonButton product={entry} />
      <a class="btn btn-outline" href="#specs">See the specs</a>
    </div>
  </PageHead>

  <section class="section section-tight">
    <div class="container product-hero">
      <div class="prose">
        <p class="notice">
          {
            p.testedHandsOn
              ? 'We have used this product ourselves.'
              : 'This page is based on manufacturer specs, retailer listings and published buyer feedback. We have not tested the product ourselves.'
          }
          {' '}Links to Amazon are affiliate links. <a href="/how-we-research/">How we research</a>
        </p>

        {
          p.verdict && (
            <div class="quick-take" id="quick-take">
              <h2>Quick take</h2>
              <p>{p.verdict}</p>
              <dl class="quick-facts">
                <div>
                  <dt>Brand</dt>
                  <dd>{p.brand}</dd>
                </div>
                {p.level.length > 0 && (
                  <div>
                    <dt>Level</dt>
                    <dd>{levelLabel(p.level)}</dd>
                  </div>
                )}
                {p.priceRange && (
                  <div>
                    <dt>Price range</dt>
                    <dd>{p.priceRange}</dd>
                  </div>
                )}
              </dl>
            </div>
          )
        }

        {
          specs.length > 0 && (
            <>
              <h2 id="specs">{p.name} specs</h2>
              <table class="specs">
                <tbody>
                  {specs.map(([key, value]) => (
                    <tr>
                      <th scope="row">{key}</th>
                      <td>{value}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </>
          )
        }

        {
          (p.pros.length > 0 || p.cons.length > 0) && (
            <>
              <h2 id="pros-and-cons">{p.name} pros and cons</h2>
              <div class="pros-cons">
                <div class="card pros">
                  <h3>
                    <Icon name="check" size={18} /> What we like
                  </h3>
                  <ul>
                    {p.pros.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                </div>
                <div class="card cons">
                  <h3>
                    <Icon name="x" size={18} /> What to consider
                  </h3>
                  <ul>
                    {p.cons.map((x) => (
                      <li>{x}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </>
          )
        }

        <Content />

        {
          p.faq.length > 0 && (
            <>
              <h2 id="faq">{p.name}: questions and answers</h2>
              <Faq items={p.faq} />
            </>
          )
        }

        {
          alternatives.length > 0 && (
            <>
              <h2 id="alternatives">{p.name} alternatives compared</h2>
              <p>
                How the {p.name} sits next to other {category.noun} we cover. Tap a name for the full specs.
              </p>
              <div class="table-wrap">
                <table class="compare-table">
                  <thead>
                    <tr>
                      <th scope="col">Product</th>
                      <th scope="col">Best for</th>
                      <th scope="col">Level</th>
                      <th scope="col">Price</th>
                      <th scope="col">Shop</th>
                    </tr>
                  </thead>
                  <tbody>
                    {compared.map((x) => (
                      <tr class={x.id === entry.id ? 'is-current' : undefined}>
                        <th scope="row">
                          {x.id === entry.id ? x.data.name : <a href={productUrl(x)}>{x.data.name}</a>}
                        </th>
                        <td>{x.data.bestFor.slice(0, 2).join(', ')}</td>
                        <td>{levelLabel(x.data.level)}</td>
                        <td>{x.data.priceRange ?? '–'}</td>
                        <td>
                          <AmazonButton product={x} small label="Amazon" />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <p class="small-print">
                {
                  p.category === 'shoes'
                    ? 'Price range for shoes: $ under $100 · $$ $100–$160 · $$$ over $160 (list prices).'
                    : 'Price range: $ budget · $$ mid-range · $$$ premium, compared within this category.'
                }
                {' '}See all <a href={`/gear/${category.id}/`}>{category.noun}</a> or read <a href={category.guide.href}>{category.guide.label.toLowerCase()}</a>.
              </p>
            </>
          )
        }

        {
          hasBuyLink && (
            <div class="buy-band">
              <div>
                <h2>Check today's price for the {p.name}</h2>
                <p>Prices change with size, color and season. The button opens Amazon with this product already searched.</p>
              </div>
              <AmazonButton product={entry} />
            </div>
          )
        }
      </div>

      <aside class="product-aside">
        <div class="buy-box">
          <div class="buy-box-media">
            <Icon name={p.category} size={46} />
          </div>
          <span class="badge">{p.brand}</span>
          <p class="buy-box-name">{p.name}</p>
          {
            p.priceRange && (
              <p class="meta">
                Price range: {p.priceRange}
                <br />
                <small>
                  {p.category === 'shoes'
                    ? '$ under $100 · $$ $100–$160 · $$$ over $160 (list prices)'
                    : '$ budget · $$ mid-range · $$$ premium (within this category)'}
                </small>
              </p>
            )
          }
          {
            hasBuyLink && (
              <>
                <AmazonButton product={entry} block />
                <p class="small">Affiliate link – we may earn a commission. Price and availability can differ by size and color.</p>
              </>
            )
          }
        </div>
        {
          toc.length > 2 && (
            <nav class="toc" aria-label="On this page">
              <p class="toc-title">On this page</p>
              <ol>
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="section-head">
            <div>
              <h2>Guides that help you decide</h2>
              <p class="section-lead">Buying guides, best-of lists and comparisons for {category.noun}.</p>
            </div>
            <a class="btn btn-outline" href={`/gear/${category.id}/`}>All {category.noun}</a>
          </div>
          <div class="grid">
            {related.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    hasBuyLink && (
      <div class="buy-bar">
        <span class="buy-bar-name">{p.name}</span>
        <AmazonButton product={entry} small />
      </div>
    )
  }
</Base>
