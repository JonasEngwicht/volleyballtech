---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { site, categories, skillLabels } from '../data/site';
import { getArticles, getDrills, drillUrl } from '../lib/content';

const latest = (await getArticles()).slice(0, 6);
const drills = (await getDrills()).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  description: site.description,
};
---

<Base title={site.name} description={site.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Volleyball gear · Volleyball tech · Training</p>
      <h1>Volleyball gear and tech, explained.</h1>
      <p class="hero-lead">
        Clear comparisons, real specs and training tips for volleyball players — from your first pair of volleyball
        shoes to jump trackers, ball machines and other volleyball tech.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/gear/">Browse volleyball gear</a>
        <a class="btn btn-ghost" href="/guides/">Read the guides</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Find volleyball gear by category</h2>
      <p class="section-lead">Volleyball shoes, knee pads, balls and tech — organized by position, level and budget, so you only see what fits your game.</p>
      <div class="grid">
        {
          categories.map((c) => (
            <a class="card" href={`/gear/${c.id}/`}>
              <span class="badge badge-accent">Gear</span>
              <h3>{c.name}</h3>
              <p>{c.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Latest volleyball guides</h2>
          <p class="section-lead">Start here before you buy anything.</p>
        </div>
        <a class="btn btn-outline" href="/guides/">All guides</a>
      </div>
      {
        latest.length > 0 ? (
          <div class="grid">
            {latest.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        ) : (
          <div class="empty">
            <p>Our first guides are on the way.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Volleyball drills: train smarter</h2>
          <p class="section-lead">Drills that show you how to actually use your gear — step by step.</p>
        </div>
        <a class="btn btn-outline" href="/drills/">All drills</a>
      </div>
      {
        drills.length > 0 ? (
          <div class="grid">
            {drills.map((d) => (
              <a class="card" href={drillUrl(d)}>
                <span class="badge">{skillLabels[d.data.skill]}</span>
                <h3>{d.data.title}</h3>
                <p>{d.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty">
            <p>The drill library is coming soon.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>How we review volleyball gear</h2>
      <p class="section-lead">Most volleyball gear advice online is either written for pros or copied from a press release. We do it differently.</p>
      <div class="principles">
        <div class="principle">
          <h3>Specs, not hype</h3>
          <p>We compare real, checkable specs side by side and explain what they mean on the court.</p>
        </div>
        <div class="principle">
          <h3>Who it's NOT for</h3>
          <p>Every recommendation says who should skip a product — not just who should buy it.</p>
        </div>
        <div class="principle">
          <h3>Honest about testing</h3>
          <p>We clearly mark which products we've used ourselves and which picks are based on research.</p>
        </div>
        <div class="principle">
          <h3>Commissions don't pick</h3>
          <p>We earn from some links, but that never decides what makes a list or where it ranks.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Join the VolleyballTech community</h2>
          <p>Gear deals, new drills and honest reviews — plus a place to ask other players what works for them.</p>
        </div>
        <a class="btn btn-primary" href="/community/">Learn more</a>
      </div>
    </div>
  </section>
</Base>
