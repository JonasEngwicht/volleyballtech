---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import { site, categories, skillLabels, featuredProducts } from '../data/site';
import { getArticles, getDrills, getProducts, drillUrl } from '../lib/content';

const allArticles = await getArticles();
const latest = allArticles.filter((a) => a.data.section !== 'learn').slice(0, 6);
const allDrills = await getDrills();
const drills = allDrills.slice(0, 3);
const products = await getProducts();
const featured = featuredProducts.map((id) => products.find((p) => p.id === id)).filter((p) => p !== undefined);
const count = (id: string) => products.filter((p) => p.data.category === id).length;

const learnSlugs = [
  'volleyball-rules',
  'volleyball-court-dimensions',
  'volleyball-net-height',
  'volleyball-rotation',
  'how-to-serve-a-volleyball',
  'how-to-spike-a-volleyball',
];
const learnAll = await getArticles('learn');
const learn = learnSlugs
  .map((id) => learnAll.find((a) => a.id === id))
  .filter((a) => a !== undefined);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    description: site.description,
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.name,
    url: site.url,
    logo: `${site.url}/logo-512.png`,
  },
];
---

<Base title={site.name} description={site.description} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div>
        <p class="eyebrow">Volleyball gear · Volleyball tech · Rules & training</p>
        <h1>Volleyball gear and tech, explained.</h1>
        <p class="hero-lead">
          Clear comparisons, real specs and training tips for volleyball players — from your first pair of volleyball
          shoes to jump trackers, tracking cameras and other volleyball tech.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/gear/">Browse volleyball gear</a>
          <a class="btn btn-ghost" href="/best/best-volleyball-shoes/">Best volleyball shoes</a>
        </div>
        <ul class="hero-stats">
          <li><strong>{products.length}</strong> products with full specs</li>
          <li><strong>{allArticles.length}</strong> guides and comparisons</li>
          <li><strong>{allDrills.length}</strong> drills with diagrams</li>
        </ul>
      </div>
      <div class="hero-art" aria-hidden="true">
        <svg viewBox="0 0 420 340" fill="none">
          <rect x="30" y="60" width="360" height="240" rx="10" stroke="rgba(255,255,255,0.28)" stroke-width="2"></rect>
          <path d="M210 60v240M150 60v240M270 60v240" stroke="rgba(255,255,255,0.28)" stroke-width="2"></path>
          <path d="M210 40v280" stroke="#ffc627" stroke-width="4" stroke-linecap="round"></path>
          <path d="M96 232c40-118 150-150 232-96" stroke="#5bbcf2" stroke-width="3" stroke-linecap="round" stroke-dasharray="2 12"></path>
          <g transform="translate(70 206)">
            <circle cx="26" cy="26" r="26" fill="#5bbcf2"></circle>
            <g stroke="#fff" stroke-width="2.4" stroke-linecap="round"><path d="M26 26a26 26 0 0 1 22.5 13"></path><path d="M26 26a26 26 0 0 1-22.5 13"></path><path d="M26 26a26 26 0 0 1 0-26"></path><path d="M36 2.4a35 35 0 0 1-.4 27.8"></path><path d="M1.5 30.500a35 35 0 0 1 24-13.5"></path><path d="M43.5 45a35 35 0 0 1-23.5-14"></path></g>
          </g>
          <circle cx="328" cy="136" r="7" fill="#ffc627"></circle>
          <circle cx="328" cy="136" r="16" stroke="#ffc627" stroke-opacity="0.5" stroke-width="2"></circle>
        </svg>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Find volleyball gear by category</h2>
      <p class="section-lead">Volleyball shoes, knee pads, balls and tech — organized by position, level and budget, so you only see what fits your game.</p>
      <div class="grid">
        {
          categories.map((c) => (
            <a class="card cat-card" href={`/gear/${c.id}/`}>
              <span class="cat-icon">
                <Icon name={c.id} size={28} />
              </span>
              <span class="badge badge-accent">{count(c.id)} products</span>
              <h3>{c.name}</h3>
              <p>{c.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="section section-alt">
        <div class="container">
          <div class="section-head">
            <div>
              <h2>Popular volleyball gear</h2>
              <p class="section-lead">A starter pick from each category. Every page lists the specs, the drawbacks and who should skip it.</p>
            </div>
            <a class="btn btn-outline" href="/gear/">All gear</a>
          </div>
          <div class="grid grid-products">
            {featured.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    learn.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <h2>New to volleyball? Learn the game</h2>
              <p class="section-lead">Volleyball rules, court size, net height, rotations and the four core skills, explained in plain English.</p>
            </div>
            <a class="btn btn-outline" href="/learn/">All basics</a>
          </div>
          <div class="grid">
            {learn.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Latest volleyball guides</h2>
          <p class="section-lead">Start here before you buy anything.</p>
        </div>
        <a class="btn btn-outline" href="/guides/">All guides</a>
      </div>
      {
        latest.length > 0 ? (
          <div class="grid">
            {latest.map((a) => (
              <ArticleCard article={a} />
            ))}
          </div>
        ) : (
          <div class="empty">
            <p>Our first guides are on the way.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>Volleyball drills: train smarter</h2>
          <p class="section-lead">Drills that show you how to actually use your gear — step by step.</p>
        </div>
        <a class="btn btn-outline" href="/drills/">All drills</a>
      </div>
      {
        drills.length > 0 ? (
          <div class="grid">
            {drills.map((d) => (
              <a class="card" href={drillUrl(d)}>
                <span class="badge">{skillLabels[d.data.skill]}</span>
                <h3>{d.data.title}</h3>
                <p>{d.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty">
            <p>The drill library is coming soon.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <h2>How we research volleyball gear</h2>
      <p class="section-lead">Most volleyball gear advice online is either written for pros or copied from a press release. We do it differently. <a href="/how-we-research/">Read our method</a>.</p>
      <div class="principles">
        <div class="principle">
          <h3>Specs, not hype</h3>
          <p>We compare real, checkable specs side by side and explain what they mean on the court.</p>
        </div>
        <div class="principle">
          <h3>Who it's NOT for</h3>
          <p>Every recommendation says who should skip a product — not just who should buy it.</p>
        </div>
        <div class="principle">
          <h3>Honest about testing</h3>
          <p>We clearly mark which products we've used ourselves and which picks are based on research.</p>
        </div>
        <div class="principle">
          <h3>Commissions don't pick</h3>
          <p>We earn from some links, but that never decides what makes a list or where it ranks.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-band">
        <div>
          <h2>Join the VolleyballTech community</h2>
          <p>Gear deals, new drills and honest reviews — plus a place to ask other players what works for them.</p>
        </div>
        <a class="btn btn-primary" href="/community/">Learn more</a>
      </div>
    </div>
  </section>
</Base>
