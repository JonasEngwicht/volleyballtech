---
import Icon from './Icon.astro';
import AmazonButton from './AmazonButton.astro';
import type { Product } from '../lib/content';
import { productUrl, levelLabel } from '../lib/content';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const p = product.data;
const url = productUrl(product);
---

<article class="product-card">
  <a class="product-card-media" href={url} tabindex="-1" aria-hidden="true">
    <Icon name={p.category} size={40} />
    <span>{p.brand}</span>
  </a>
  <div class="product-card-body">
    <h3><a href={url}>{p.name}</a></h3>
    <p>{p.summary}</p>
    <ul class="product-card-facts">
      {p.bestFor.length > 0 && <li><strong>Best for:</strong> {p.bestFor.slice(0, 2).join(', ')}</li>}
      {p.level.length > 0 && <li><strong>Level:</strong> {levelLabel(p.level)}</li>}
      {p.priceRange && <li><strong>Price range:</strong> {p.priceRange}</li>}
    </ul>
  </div>
  <div class="product-card-actions">
    <a class="btn btn-small btn-outline" href={url}>Full details<span class="sr-only">: {p.name}</span></a>
    <AmazonButton product={product} small />
  </div>
</article>
