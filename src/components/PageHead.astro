---
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  title: string;
  lead?: string;
  crumbs?: Crumb[];
}

const { title, lead, crumbs = [] } = Astro.props;
---

<section class="page-head">
  <div class="container">
    {
      crumbs.length > 0 && (
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          {crumbs.map((c) => (
            <>
              {' / '}
              <a href={c.href}>{c.label}</a>
            </>
          ))}
        </nav>
      )
    }
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
